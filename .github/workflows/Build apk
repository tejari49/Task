name: Build APK (Debug)

on:
  workflow_dispatch:
  push:
    branches: ["main", "master"]

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      WORKDIR: Task-copilot-create-final-apk

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js (>=22 required by Capacitor)
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"
          cache-dependency-path: ${{ env.WORKDIR }}/package-lock.json

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "21"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install dependencies (npm)
        working-directory: ${{ env.WORKDIR }}
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web assets (Vite -> dist)
        working-directory: ${{ env.WORKDIR }}
        run: |
          set -e
          echo "==> npm run build"
          npm run build
          echo "==> dist content"
          ls -la dist
          test -f dist/index.html

      - name: Capacitor sync Android
        working-directory: ${{ env.WORKDIR }}
        run: npx cap sync android

      - name: Make Gradlew executable
        run: chmod +x ${{ env.WORKDIR }}/android/gradlew

      - name: Build Debug APK
        working-directory: ${{ env.WORKDIR }}/android
        run: ./gradlew assembleDebug

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: taskrai-debug-apk
          path: ${{ env.WORKDIR }}/android/app/build/outputs/apk/debug/*.apk
