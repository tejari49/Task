name: Build APK (Debug)

on:
  workflow_dispatch:
  push:
    branches: ["main", "master"]

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      WORKDIR: Task-copilot-create-final-apk

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js (>=22 required by Capacitor)
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"
          cache-dependency-path: ${{ env.WORKDIR }}/package-lock.json

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "21"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install dependencies (npm)
        working-directory: ${{ env.WORKDIR }}
        run: |
          echo "[INFO] Installing dependencies"
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web assets (Vite -> dist)
        working-directory: ${{ env.WORKDIR }}
        run: |
          echo "[INFO] Building web assets"
          npm run build
          echo "[INFO] dist content"
          ls -la dist
          test -f dist/index.html

      - name: Capacitor sync Android
        working-directory: ${{ env.WORKDIR }}
        run: |
          echo "[INFO] Capacitor sync android"
          npx cap sync android || { echo "::error::Capacitor sync failed"; exit 1; }

      - name: Make Gradlew executable
        run: chmod +x ${{ env.WORKDIR }}/android/gradlew

      - name: Build Debug APK
        working-directory: ${{ env.WORKDIR }}/android
        run: |
          echo "[INFO] Building debug APK"
          ./gradlew assembleDebug || { echo "::error::Gradle build failed"; exit 1; }

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: taskrai-debug-apk
          path: ${{ env.WORKDIR }}/android/app/build/outputs/apk/debug/*.apk

      - name: 🎯 Show APK path & plugins
        run: |
          echo "[INFO] APK should be in ${{ env.WORKDIR }}/android/app/build/outputs/apk/debug/"
          echo "[INFO] Capacitor plugins (from package.json):"
          cat ${{ env.WORKDIR }}/package.json | grep capacitor
